API_PORT=4000
WORKER_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_ENV=development
LOG_LEVEL=info

# Clerk development instance. Replace these placeholders after copying to .env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Optional credentials for the authenticated Playwright journey.
# E2E_CLERK_USER_EMAIL=foundation+clerk_test@example.com
# E2E_CLERK_ORGANIZATION_SLUG=foundation-e2e
# E2E_CLERK_SECOND_ORGANIZATION_SLUG=foundation-e2e-secondary
# Non-Owner Membership already present in Clerk and PostgreSQL for the integrated lifecycle smoke test.
# E2E_MEMBERSHIP_TARGET_USER_ID=user_2abc

# Server-only Stripe catalog mappings. Replace these with test-mode IDs.
STRIPE_LAUNCH_PRODUCT_ID=prod_launchExample
STRIPE_LAUNCH_PRICE_ID=price_launchExample
STRIPE_SCALE_PRODUCT_ID=prod_scaleExample
STRIPE_SCALE_PRICE_ID=price_scaleExample

POSTGRES_DB=saas
POSTGRES_PASSWORD=saas
POSTGRES_PORT=5432
POSTGRES_USER=saas
DATABASE_URL=postgresql://saas:saas@localhost:5432/saas
# Use Neon's direct, non-pooled connection for Prisma migrations in deployed environments.
DIRECT_DATABASE_URL=postgresql://saas:saas@localhost:5432/saas
# Local-only database used by the non-skippable PostgreSQL integration suite.
TEST_DATABASE_URL=postgresql://saas:saas@localhost:5432/saas

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Optional observability. Leave blank to keep telemetry disabled.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# SENTRY_DSN=

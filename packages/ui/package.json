{
  "name": "@saas/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build-storybook": "storybook build",
    "lint": "oxlint src/ .storybook/ tests/",
    "storybook": "storybook dev --port 6006",
    "test": "vitest run --project=unit --project=storybook",
    "test:storybook": "vitest run --project=storybook",
    "test:visual": "vitest run --project=visual",
    "test:visual:update": "vitest run --project=visual --update",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./styles.css": "./src/styles.css"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "30.0.1",
    "next": "16.3.5",
    "oxlint": "^1.58.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

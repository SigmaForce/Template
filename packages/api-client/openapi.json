            "type": "string"
          }
        },
        "required": [
          "id",
          "slug"
        ],
        "type": "object"
      },
      "ActiveOrganizationDto": {
        "properties": {
          "id": {
            "example": "org_2abc",
            "type": "string"
          },
          "permissions": {
            "items": {
              "enum": [
                "organization:settings:read",
                "organization:settings:update",
                "organization:memberships:manage",
                "organization:memberships:leave",
                "billing:manage",
                "organization:ownership:manage",
                "organization:delete"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "role": {
            "enum": [
              "admin",
              "member",
              "owner"
            ],
            "type": "string"
          },
          "slug": {
            "example": "northstar-labs",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "role",
          "permissions"
        ],
        "type": "object"
      },
      "AuthenticatedUserDto": {
        "properties": {
          "id": {
            "example": "user_2RfWKJREkjKbHZy0Wqa5qrHeAnb",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "CapabilityDto": {
        "properties": {
          "description": {
            "example": "View and manage the Organization Plan.",
            "type": "string"
          },
          "id": {
            "enum": [
              "billing",
              "organization-memberships",
              "organization-settings"
            ],
            "example": "billing",
            "type": "string"
          },
          "name": {
            "example": "Billing",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "type": "object"
      },
      "ContractExampleDto": {
        "properties": {
          "businessDate": {
            "example": "2026-01-15",
            "format": "date",
            "type": "string"
          },
          "createdAt": {
            "example": "2026-01-15T14:30:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Opaque public UUIDv7 identifier.",
            "example": "018f0c4a-7b5d-7cc4-b3e1-5a6f8d9c1001",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "localBusinessTime": {
            "$ref": "#/components/schemas/LocalBusinessTimeDto"
          },
          "name": {
            "example": "Foundation contract",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "retiredAt": {
            "description": "Explicit null means the resource has not been retired.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "summary": {
            "description": "An absent property means no summary was supplied.",
            "example": "Generated from the public OpenAPI document.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "businessDate",
          "localBusinessTime",
          "price",
          "retiredAt"
        ],
        "type": "object"
      },
      "ContractExamplePageDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ContractExampleDto"
            },
            "type": "array"
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfoDto"
          }
        },
        "required": [
          "items",
          "pageInfo"
        ],
        "type": "object"
      },
      "CreateInvitationDto": {
        "properties": {

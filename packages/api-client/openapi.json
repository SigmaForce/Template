          },
          "role": {
            "enum": [
              "admin",
              "member",
              "owner"
            ],
            "example": "member",
            "type": "string"
          }
        },
        "required": [
          "emailAddress",
          "role"
        ],
        "type": "object"
      },
      "CreateOrganizationDto": {
        "properties": {
          "locale": {
            "enum": [
              "en-US",
              "pt-BR"
            ],
            "example": "pt-BR",
            "type": "string"
          },
          "name": {
            "example": "Northstar Labs",
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "slug": {
            "example": "northstar-labs",
            "maxLength": 48,
            "minLength": 3,
            "type": "string"
          },
          "timeZone": {
            "enum": [
              "America/Cuiaba",
              "America/Sao_Paulo",
              "UTC"
            ],
            "example": "America/Cuiaba",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug",
          "locale",
          "timeZone"
        ],
        "type": "object"
      },
      "DependencyReadinessDto": {
        "properties": {
          "critical": {
            "type": "boolean"
          },
          "name": {
            "example": "database",
            "type": "string"
          },
          "status": {
            "enum": [
              "up",
              "down",
              "configured",
              "disabled",
              "misconfigured"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "critical",
          "status"
        ],
        "type": "object"
      },
      "LocalBusinessTimeDto": {
        "properties": {
          "localTime": {
            "example": "09:30:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
            "type": "string"
          },
          "timeZone": {
            "example": "America/Cuiaba",
            "type": "string"
          }
        },
        "required": [
          "localTime",
          "timeZone"
        ],
        "type": "object"
      },
      "MembershipDto": {
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member",
              "owner"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "removed",
              "suspended"
            ],
            "type": "string"
          },
          "userId": {
            "example": "user_2abc",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "role",
          "status"
        ],
        "type": "object"
      },
      "MembershipListDto": {
        "properties": {
          "items": {

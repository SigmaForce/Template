            "$ref": "#/components/schemas/PageInfoDto"
          }
        },
        "required": [
          "items",
          "pageInfo"
        ],
        "type": "object"
      },
      "MoneyDto": {
        "properties": {
          "amountMinor": {
            "description": "Integer minor units encoded as a decimal string.",
            "example": "4900",
            "pattern": "^-?[0-9]+$",
            "type": "string"
          },
          "currency": {
            "example": "BRL",
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "type": "object"
      },
      "OrganizationDto": {
        "properties": {
          "billingContactEmail": {
            "example": "billing@northstar.test",
            "format": "email",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "example": "org_2abc",
            "type": "string"
          },
          "locale": {
            "example": "pt-BR",
            "type": "string"
          },
          "name": {
            "example": "Northstar Labs",
            "type": "string"
          },
          "slug": {
            "example": "northstar-labs",
            "type": "string"
          },
          "timeZone": {
            "example": "America/Cuiaba",
            "type": "string"
          }
        },
        "required": [
          "billingContactEmail",
          "id",
          "name",
          "slug",
          "locale",
          "timeZone"
        ],
        "type": "object"
      },
      "OrganizationInvitationDto": {
        "properties": {

      "UpdateOrganizationSettingsDto": {
        "properties": {
          "billingContactEmail": {
            "example": "billing@northstar.test",
            "format": "email",
            "nullable": true,
            "type": "string"
          },
          "locale": {
            "enum": [
              "en-US",
              "pt-BR"
            ],
            "example": "pt-BR",
            "type": "string"
          },
          "name": {
            "example": "Northstar Labs",
            "maxLength": 100,
            "minLength": 2,

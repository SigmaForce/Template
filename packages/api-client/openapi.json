          },
          "slug": {
            "example": "northstar-labs",
            "maxLength": 48,
            "minLength": 3,
            "type": "string"
          },
          "timeZone": {
            "enum": [
              "America/Cuiaba",
              "America/Sao_Paulo",
              "UTC"
            ],
            "example": "America/Cuiaba",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "clerk-session": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Stable HTTP contract for the SaaS foundation.",
    "title": "Next Nest SaaS Starter API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/v1/auth/me": {
      "get": {
        "operationId": "getAuthenticatedUser",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUserDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "A valid Clerk session token is required."
          }
        },
        "security": [
          {
            "clerk-session": []
          }
        ],
        "summary": "",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/v1/billing/stripe/webhooks": {
      "post": {
        "operationId": "receiveStripeWebhook",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "received": true
                  }
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "The Stripe signature is invalid."
          }
        },
        "summary": "",
        "tags": [
          "billing"
        ]
      }
    },
    "/v1/contract-examples": {
      "get": {
        "operationId": "listContractExamples",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "currency",
            "required": false,
            "schema": {
              "enum": [
                "BRL",
                "USD"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractExamplePageDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "The pagination request is invalid."
          }
        },
        "summary": "",
        "tags": [
          "Contract examples"
        ]
      }
    },

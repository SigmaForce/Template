            ],
            "example": "launch",
            "type": "string"
          },
          "planVersion": {
            "example": 1,
            "type": "number"
          },
          "providerSubscriptionId": {
            "example": "sub_2abc",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "canceled",
              "incomplete",
              "incomplete_expired",
              "past_due",
              "paused",
              "trialing",
              "unpaid"

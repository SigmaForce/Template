          "name",
          "version",
          "seatAllowance",
          "capabilities"
        ],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "correlationId": {
            "example": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
            "type": "string"
          },
          "detail": {
            "example": "One or more request values are invalid.",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemValidationErrorDto"
            },
            "type": "array"
          },
          "instance": {
            "example": "urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
            "type": "string"
          },
          "status": {
            "example": 400,
            "type": "number"
          },
          "title": {
            "example": "Request validation failed",
            "type": "string"
          },
          "type": {
            "example": "urn:problem:next-nest-saas-starter:validation",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "correlationId"
        ],
        "type": "object"
      },
      "ProblemValidationErrorDto": {
        "properties": {
          "detail": {
            "example": "limit must not be greater than 100",
            "type": "string"
          },
          "pointer": {
            "example": "#/query/limit",
            "type": "string"
          }
        },
        "required": [
          "detail",
          "pointer"
        ],
        "type": "object"
      },
      "ReadinessDto": {
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyReadinessDto"

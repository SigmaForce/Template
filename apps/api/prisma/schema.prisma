generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum OnboardingStatus {
  PROCESSING
  COMPLETED
}

enum OrganizationState {
  ACTIVE
  READ_ONLY
  PENDING_DELETION
}

model Organization {
  id        String            @id @db.VarChar(64)
  name      String            @db.VarChar(100)
  slug      String            @unique @db.VarChar(48)
  locale    String            @db.VarChar(35)
  timeZone  String            @map("time_zone") @db.VarChar(64)
  state     OrganizationState @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  memberships       Membership[]
  onboardingRequest OrganizationOnboardingRequest?

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.VarChar(64)
  userId         String           @map("user_id") @db.VarChar(64)
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model OrganizationOnboardingRequest {
  userId         String           @id @map("user_id") @db.VarChar(64)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  requestHash    String           @map("request_hash") @db.Char(64)
  status         OnboardingStatus @default(PROCESSING)
  organizationId String?          @unique @map("organization_id") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_onboarding_requests")
}

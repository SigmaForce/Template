generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OnboardingStatus {
  PROCESSING
  COMPLETED
}

enum OrganizationState {
  ACTIVE
  READ_ONLY
  PENDING_DELETION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Organization {
  id                  String            @id @db.VarChar(64)
  name                String            @db.VarChar(100)
  slug                String            @unique @db.VarChar(48)
  billingContactEmail String?           @map("billing_contact_email") @db.VarChar(320)
  locale              String            @db.VarChar(35)
  timeZone            String            @map("time_zone") @db.VarChar(64)
  state               OrganizationState @default(ACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  memberships        Membership[]
  invitations        Invitation[]
  slugs              OrganizationSlug[]
  onboardingRequest  OrganizationOnboardingRequest?
  billingInboxEvents BillingInboxEvent[]
  subscription       Subscription?
  auditEvents        AuditEvent[]
  apiKeys            ApiKey[]
  files              File[]
  webhookEndpoints   WebhookEndpoint[]
  notifications      Notification[]

  @@map("organizations")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.VarChar(64)
  actorType      String   @map("actor_type") @db.VarChar(16)
  actorId        String   @map("actor_id") @db.VarChar(64)
  action         String   @db.VarChar(100)
  targetType     String   @map("target_type") @db.VarChar(64)
  targetId       String   @map("target_id") @db.VarChar(255)
  context        Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("audit_events")
}

model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.VarChar(64)
  name            String    @db.VarChar(100)
  scopes          String[]
  secretHash      String    @map("secret_hash") @db.Char(64)
  createdByUserId String    @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("api_keys")
}

model OperatorSession {
  id              String    @id @db.VarChar(128)
  operatorId      String    @map("operator_id") @db.VarChar(64)
  permissions     String[]
  organizationIds String[]  @map("organization_ids")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([operatorId, expiresAt])
  @@map("operator_sessions")
}

model File {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.VarChar(64)
  name            String   @db.VarChar(255)
  contentType     String   @map("content_type") @db.VarChar(100)
  size            Int
  objectKey       String   @unique @map("object_key") @db.VarChar(255)
  createdByUserId String   @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("files")
}

model WebhookEndpoint {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.VarChar(64)
  url             String            @db.VarChar(2048)
  events          String[]
  secret          String            @db.VarChar(255)
  enabled         Boolean           @default(true)
  createdByUserId String            @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String                  @id @db.VarChar(255)
  endpointId    String                  @map("endpoint_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.VarChar(64)
  eventType     String                  @map("event_type") @db.VarChar(120)
  version       String                  @db.VarChar(32)
  payload       Json
  occurredAt    DateTime                @map("occurred_at") @db.Timestamptz(3)
  status        String                  @db.VarChar(24)
  attemptCount  Int                     @default(0) @map("attempt_count")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt DateTime?               @map("last_attempt_at") @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts WebhookDeliveryAttempt[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("webhook_deliveries")
}

model WebhookDeliveryAttempt {
  id             String           @id @default(uuid()) @db.Uuid
  deliveryId     String           @map("delivery_id") @db.VarChar(255)
  number         Int
  status         String           @db.VarChar(16)
  responseStatus Int?             @map("response_status")
  error          String?          @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, number])
  @@map("webhook_delivery_attempts")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  dedupeKey      String           @unique @map("dedupe_key") @db.VarChar(255)
  organizationId String           @map("organization_id") @db.VarChar(64)
  kind           String           @db.VarChar(80)
  recipientEmail String           @map("recipient_email") @db.VarChar(320)
  payload        Json
  status         String           @db.VarChar(24)
  attemptCount   Int              @default(0) @map("attempt_count")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempts NotificationAttempt[]
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

model NotificationAttempt {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  number         Int
  status         String       @db.VarChar(16)
  error          String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, number])
  @@map("notification_attempts")
}

model BillingInboxEvent {
  eventId                String    @id @map("event_id") @db.VarChar(255)
  organizationId         String?   @map("organization_id") @db.VarChar(64)
  type                   String    @db.VarChar(100)
  providerSubscriptionId String    @map("provider_subscription_id") @db.VarChar(255)
  providerCustomerId     String?   @map("provider_customer_id") @db.VarChar(255)
  priceId                String?   @map("price_id") @db.VarChar(255)
  scheduledPriceId       String?   @map("scheduled_price_id") @db.VarChar(255)
  subscriptionStatus     String?   @map("subscription_status") @db.VarChar(32)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  currentPeriodEndsAt    DateTime? @map("current_period_ends_at")
  providerCreatedAt      DateTime  @map("provider_created_at")
  payload                Json
  receivedAt             DateTime  @default(now()) @map("received_at")
  processedAt            DateTime? @map("processed_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, providerCreatedAt])
  @@map("billing_inbox_events")
}

model Subscription {
  organizationId                 String    @id @map("organization_id") @db.VarChar(64)
  providerSubscriptionId         String    @unique @map("provider_subscription_id") @db.VarChar(255)
  providerCustomerId             String?   @map("provider_customer_id") @db.VarChar(255)
  planId                         String    @map("plan_id") @db.VarChar(32)
  planVersion                    Int       @map("plan_version")
  scheduledPlanId                String?   @map("scheduled_plan_id") @db.VarChar(32)
  status                         String    @db.VarChar(32)
  cancelAtPeriodEnd              Boolean   @default(false) @map("cancel_at_period_end")
  currentPeriodEndsAt            DateTime  @map("current_period_ends_at")
  pastDueAt                      DateTime? @map("past_due_at")
  providerEventCreatedAt         DateTime  @map("provider_event_created_at")
  providerScheduleEventCreatedAt DateTime? @map("provider_schedule_event_created_at")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model OrganizationSlug {
  slug           String   @id @db.VarChar(48)
  organizationId String   @map("organization_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_slugs")
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.VarChar(64)
  emailAddress     String           @map("email_address") @db.VarChar(320)
  role             MembershipRole
  status           InvitationStatus @default(PENDING)
  externalId       String           @unique @map("external_id") @db.VarChar(64)
  invitedByUserId  String           @map("invited_by_user_id") @db.VarChar(64)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.VarChar(64)
  expiresAt        DateTime         @map("expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, emailAddress])
  @@index([status, expiresAt])
  @@map("invitations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.VarChar(64)
  userId         String           @map("user_id") @db.VarChar(64)
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model OrganizationOnboardingRequest {
  userId         String           @id @map("user_id") @db.VarChar(64)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  requestHash    String           @map("request_hash") @db.Char(64)
  status         OnboardingStatus @default(PROCESSING)
  organizationId String?          @unique @map("organization_id") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_onboarding_requests")
}
